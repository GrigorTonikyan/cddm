# CDDM Code De-Duplication Meister — Suppression Rules (.cddmignore)
# Global path ignore patterns (globs):
node_modules/**
target/**
dist/**
build/**
.git/**
.logs/**
.cddm/**
.vite-hooks/**
packaging/**
npm/**
editors/**
test-results/**

# Tests, test fixtures, and mock suites:
tests/**
scripts/tests/**
webui/src/**/*.test.ts
webui/src/**/*.test.tsx
**/*.test.*
**/*.spec.*

# Generated code files:
*.generated.*
*.pb.go
*_pb2.py
*.g.dart

# Declarative stylesheets & structured data configs (pure declarative assets)
[type-filter] **/*.css ignore=Exact,Renamed,NearMiss,Semantic
[type-filter] **/*.json ignore=Exact,Renamed,NearMiss,Semantic
[type-filter] **/*.toml ignore=Exact,Renamed,NearMiss,Semantic

# Domain data models, protocol schemas, and UI layout scaffold thresholds
[threshold] **/types/** min_tokens=150
[threshold] **/types.rs min_tokens=150
[threshold] crates/** min_tokens=100
[threshold] webui/src/** min_tokens=100
[threshold] scripts/** min_tokens=100
