#!/usr/bin/env sh
echo "=== [Vite+ Git Hooks] Running Pre-Commit Checks ==="

echo "--> Running Vite+ staged checks & linters..."
vp staged

echo "--> Checking file length and modularity policy..."
bun scripts/check-file-length.ts

# Only run Rust checks if Rust files are staged
if git diff --cached --name-only | grep -qE '\.rs$'; then
  echo "--> Staged Rust files detected: verifying formatting & clippy..."
  cargo fmt --check
  cargo clippy --workspace --all-targets -- -D warnings
fi

echo "=== [Vite+ Git Hooks] All pre-commit checks PASSED cleanly! ==="
