{
  "name": "cddm-workspace",
  "version": "4.9.2",
  "private": true,
  "description": "Root workspace scripts for CDDM (Code De-Duplication Meister)",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "prepare": "bun scripts/setup-hooks.ts && bun scripts/setup-deps.ts",
    "setup:deps": "bun scripts/setup-deps.ts",
    "fmt": "cargo fmt && vp fmt",
    "fmt:check": "cargo fmt --check && vp check",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "lint:webui": "vp -C webui run lint",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && vp check",
    "check:rust": "cargo check --workspace --all-targets",
    "check:webui": "vp -C webui run check",
    "check:scripts": "bunx tsc -p tsconfig.json",
    "check:docs": "bun scripts/check-docs.ts",
    "check:emojis": "bun scripts/check-no-emojis.ts",
    "check:file-lengths": "bun scripts/check-file-length.ts",
    "check:parity": "bun scripts/check-feature-parity.ts",
    "sync:docs": "bun scripts/sync-docs.ts",
    "sync:wiki": "bun scripts/sync-wiki.ts",
    "check": "cargo check --workspace --all-targets && vp check && bunx tsc -p tsconfig.json && bun scripts/check-docs.ts && bun scripts/check-no-emojis.ts && bun scripts/check-file-length.ts && bun scripts/check-feature-parity.ts && bun scripts/version.ts --check",
    "test:rust": "cargo test --workspace",
    "test:webui": "vp -C webui run test",
    "test:scripts": "bun test scripts/tests",
    "test:mcp": "bun test tests/mcp",
    "test:e2e": "playwright test tests/e2e/scan-workflow.spec.ts tests/e2e/navigation-coverage.spec.ts --config=tests/e2e/playwright.config.ts",
    "test": "cargo test --workspace && vp -C webui run test && bun test scripts/tests && bun test tests/mcp",
    "self-scan": "cargo run -p cddm-cli -- scan . --min-tokens 50 --fail-threshold 5.0",
    "commitlint": "commitlint --edit",
    "changelog": "bun scripts/version.ts --dry-run",
    "bump": "bun scripts/version.ts",
    "version:check": "bun scripts/version.ts --check",
    "version:check-pr": "bun scripts/version.ts --check-pr",
    "version:bump": "bun scripts/version.ts",
    "version:release": "bun scripts/version.ts --git-tag",
    "build:webui": "vp -C webui run build",
    "build:rust": "cargo build --workspace",
    "build:dev": "vp -C webui run build && cargo build --workspace",
    "build": "vp -C webui run build && cargo build --release --workspace",
    "build:release": "vp -C webui run build && cargo build --release --workspace",
    "verify": "bun scripts/verify.ts",
    "bench": "cargo bench -p cddm-core",
    "fix": "bun scripts/fix.ts",
    "clean": "bun scripts/clean.ts",
    "reset": "bun scripts/reset.ts",
    "package:vscode": "bun scripts/package-vscode.ts",
    "package:distribution": "bun scripts/package-distribution.ts",
    "release:publish": "bun scripts/publish-release.ts",
    "release:dry-run": "bun scripts/publish-release.ts --dry-run",
    "publish:cargo": "bun scripts/publish-cargo.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
