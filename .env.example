# CDDM Environment Configuration Template
# Copy this file to .env and configure local credentials.
# NEVER commit credentials or real private tokens to version control.

# Gitea SSoT Portal & Forge Credentials
GITEA_BASE=https://git.gt-web-dev.com
GITEA_REPO=gt-dev/cddm
GITEA_OWNER=gt-dev
GITEA_TOKEN=your_gitea_personal_access_token_here

# Container Registry Token for DinD / VCS Container Builds
REGISTRY_TOKEN=your_gitea_registry_pat_here
